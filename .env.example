REDIS_HOST=redis
REDIS_PORT=6379

DEBUG=1
DJANGO_PORT=8001
FRONT_PORT=8000

SECRET_KEY=change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Postgres — requis par le journal d'audit (REVOKE UPDATE/DELETE au niveau base,
# donc besoin de vrais rôles DB : voir docs/fr/journal-audit-postgres.md).
POSTGRES_DB=cartepro
POSTGRES_USER=cartepro_owner
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Rôle propriétaire (DDL, migrations, GRANT/REVOKE) — utilisé par `manage.py migrate`.
DATABASE_URL=postgres://cartepro_owner:change-me@db:5432/cartepro

# Rôle applicatif restreint (pas d'UPDATE/DELETE sur la table d'audit), créé par la
# migration `audit.0002`. Mot de passe du rôle applicatif :
AUDIT_APP_DB_PASSWORD=change-me-too
# Si définie, prend le pas sur DATABASE_URL pour le serveur en cours d'exécution
# (pas pour les migrations). Laisser commentée en dev courant : décommenter pour
# tester/démontrer le comportement du rôle restreint.
# APP_DATABASE_URL=postgres://cartepro_app:change-me-too@db:5432/cartepro

# Clé HMAC-SHA256 de signature des exports du journal d'audit
# (`manage.py export_audit_log`) et de leur vérification hors ligne
# (`audit/verify_export.py`). À changer en déploiement réel, à ne jamais committer.
AUDIT_EXPORT_HMAC_KEY=change-me-too-please
